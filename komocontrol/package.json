{
  "name": "komocontrol",
  "private": true,
  "version": "0.3.0",
  "author": { "name": "D.Seretidis" },
  "description": "Official Scoring Application for KomoBasket",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run src",
    "test:persistence": "npm run desktop:compile && vitest run electron/persistence/local-database.test.mjs",
    "test:auth": "npm run desktop:compile && vitest run electron/auth/auth-foundation.test.mjs",
    "test:discovery": "npm run desktop:compile && vitest run electron/games/game-discovery.test.mjs",
    "preview": "vite preview",
    "desktop:dev": "npm run desktop:compile && node scripts/electron-dev.cjs",
    "desktop:typecheck": "tsc -p tsconfig.shared-electron.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "desktop:compile": "tsc -p tsconfig.shared-electron.json && tsc -p tsconfig.electron.json",
    "desktop:build": "npm run build && npm run desktop:compile",
    "desktop:pack": "npm run desktop:build && electron-builder --dir --win --x64",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "gr.komobasket.komocontrol",
    "productName": "KomoControl",
    "copyright": "© 2026 D.Seretidis. All rights reserved.",
    "afterSign": "scripts/windows-release-metadata.cjs",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "electron/migrations",
        "to": "local-migrations",
        "filter": [
          "**/*.sql"
        ]
      },
      {
        "from": "build/KomoControl.ico",
        "to": "KomoControl.ico"
      }
    ],
    "win": {
      "icon": "build/KomoControl.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/KomoControl.ico",
      "uninstallerIcon": "build/KomoControl.ico"
    }
  }
}
