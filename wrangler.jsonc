{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "komobasket",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "komobasket"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "NEWS_DB",
      "database_name": "komobasket-news",
      "database_id": "d7947fb0-124a-4bc0-bdff-a7e1e9664a70",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEWS_IMAGES",
      "bucket_name": "komobasket-news-assets"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "komobasketleague@gmail.com",
    "FACEBOOK_PAGE_ID": "103249881114737",
    "FACEBOOK_GRAPH_VERSION": "v26.0",
    "KOMOBASKET_PUBLIC_URL": "https://komobasket.gr"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}