# Create a sending-only API key at https://resend.com/api-keys
RESEND_API_KEY=re_replace_with_your_key

# This address must belong to a domain verified in Resend.
CONTACT_FROM_EMAIL=KomoBasket <contact@komobasket.gr>

# Cloudflare Turnstile protects the public contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_your_site_key
TURNSTILE_SECRET_KEY=replace_with_your_secret_key

# Only this Cloudflare Access user can open the news administration APIs.
ADMIN_EMAIL=komobasketleague@gmail.com
